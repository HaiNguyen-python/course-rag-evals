# Embeddings: "hashing" (offline, default), "sentence-transformers", or "openai"
EMBEDDER=hashing
# Answer generation: "extractive" (offline, default) or "openai" (any OpenAI-compatible API, e.g. Ollama)
GENERATOR=extractive
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=not-needed-for-ollama
# Prices in USD per 1M tokens, for the cost report (0 for local models)
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
# Vector store: "memory" (files in ./index) or "postgres"
STORE=memory
POSTGRES_DSN=postgresql://rag:rag@localhost:5433/rag
